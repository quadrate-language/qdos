# QDOS on the Raspberry Pi Zero W.
#
# The 32-bit ARMv6 target. Derived from Buildroot's raspberrypi0w_defconfig,
# with the same QDOS package, rootfs and boot files as the Zero 2 W build --
# only the architecture, kernel config and device tree differ.

BR2_arm=y
BR2_arm1176jzf_s=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_VFPV2=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV6_EABIHF_GLIBC_STABLE=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_QDOS_PATH)/board/device_table.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_QDOS_PATH)/board/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_QDOS_PATH)/board/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_QDOS_PATH)/board/post-image.sh"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,999cdc63ae791860a8b09da3af90e5dfe603cc09)/linux-999cdc63ae791860a8b09da3af90e5dfe603cc09.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcmrpi"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2708-rpi-zero-w"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_QDOS_PATH)/board/linux-qdos.fragment $(BR2_EXTERNAL_QDOS_PATH)/board/linux-trim.fragment"
# Drawn the moment the framebuffer exists, about a second before init runs.
# Rendered from QDOS's own font so the machine looks the same from the first
# thing on screen to the shell.
BR2_LINUX_KERNEL_CUSTOM_LOGO_PATH="$(BR2_EXTERNAL_QDOS_PATH)/board/logo.png"

BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y

BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_QDOS_PATH)/board/config-zerow.txt"

BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# C++ and threads, which the Quadrate front-end needs
BR2_TOOLCHAIN_BUILDROOT_CXX=y

BR2_PACKAGE_QDOS=y

BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="80M"
# BR2_TARGET_ROOTFS_TAR is not set

BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
