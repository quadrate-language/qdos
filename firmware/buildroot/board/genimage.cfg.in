# Template. post-image.sh fills in @DTB@ and @KERNEL@ from the active
# defconfig, so one layout serves both the Zero W and the Zero 2 W.
#
# Two partitions: the firmware's FAT boot partition, and a read-only rootfs.
#
# The rootfs is mounted ro so an unclean power-off -- which is how a calculator
# is always switched off -- cannot corrupt it. Anything QDOS writes goes to a
# separate data partition; see post-build.sh.

image boot.vfat {
	vfat {
		files = {
			"@DTB@",
			"rpi-firmware/bootcode.bin",
			"rpi-firmware/cmdline.txt",
			"rpi-firmware/config.txt",
			"rpi-firmware/fixup.dat",
			"rpi-firmware/start.elf",
			"@KERNEL@"
		}
		file overlays {
			image = "rpi-firmware/overlays"
		}
		# Where programs uploaded from a PC land; see post-build.sh
		file qdos {
			image = "qdos-inbox"
		}
	}
	# bcm2711_defconfig builds a bigger kernel than bcmrpi3 did; 32M left
	# only ~6MB spare and overflowing here fails late, after the whole build.
	size = 64M
}

image data.ext4 {
	ext4 {
		label = "qdos-data"
		use-mke2fs = true
	}
	# Populated from /var/lib/qdos in the rootfs, which post-build.sh leaves
	# empty. Without this genimage would fill it from the whole root path.
	mountpoint = "/var/lib/qdos"
	size = 16M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
