// Sudoku. Three presses set a cell, each digit standing where it sits on the
// keypad, 7 at the top left: the box, the cell in the box, then the number.
// 0 or DEL clears, the arrows move, ESC goes back a step. Saved as it goes.

// A digit key as a row and column of three, 7 8 9 on top as on the keypad
fn place(d:i64 -- r:i64 c:i64) {
	2 d 1 - 3 / - d 1 - 3 %
}

// A digit key, or one typed; -1 for any other
fn digit_of(key:i64 ch:i64 -- d:i64) {
	key 1 >= key 10 <= and if { key 1 - return }
	ch 48 >= ch 57 <= and if { ch 48 - return }
	-1
}

fn clock(s:i64 -- t:str) {
	s 60 / ":" ui::cat s 60 % 10 < if { "0" } else { "" } ui::cat s 60 % ui::cat
}

fn board(g:[]i64 f:[]i64 level:i64 now:i64 step:i64 box:i64 i:i64 marks:i64 -- ) {
	ui::cls
	0 81 1 for k {
		g k nth -> v
		v 0 != if {
			k 9 % 24 * 16 + -> x
			k 9 / 24 * 12 + -> y
			x y v 1 ui::write
			// Given numbers struck twice, which is bold on a panel with one weight
			f k nth 1 == if { x 1 + y v 1 ui::write }
			marks 1 == g k clash 1 == and if { x 1 - y 21 + 18 2 1 ui::box }
		}
	}
	0 10 1 for n {
		n 3 % 0 == if { 2 } else { 1 } -> w
		n 24 * 12 + -> p
		12 p 216 w 1 ui::box
		p w - 1 + 12 w 216 1 ui::box
	}
	step 1 == if { box 3 % 72 * 12 + box 3 / 72 * 12 + 72 72 -1 ui::box }
	step 2 == if { i 9 % 24 * 12 + i 9 / 24 * 12 + 24 24 -1 ui::box }
	[]str -> names
	names "" append "EASY" append "MEDIUM" append "HARD" append drop
	[]str -> asks
	asks "BOX?" append "CELL?" append "NUMBER?" append drop
	248 12 "SUDOKU" 1 ui::write
	248 44 names level nth ui::small
	248 64 now clock ui::small
	248 96 asks step nth 1 ui::write
	248 136 "7 8 9 IS THE TOP" ui::small
	248 176 "0 OR DEL CLEARS" ui::small
	248 196 "ESC GOES BACK" ui::small
}

fn play(g:[]i64 f:[]i64 level:i64 seconds:i64 marks:i64 -- ) {
	ui::ticks -> start
	0 -> step
	4 -> box
	40 -> i
	loop {
		seconds ui::ticks start - 1000 / + -> now
		g f level now step box i marks board
		g solved 1 == if {
			240 90 160 80 2 ui::box
			248 96 "SOLVED" 1 ui::write
			248 128 now clock ui::small
			ui::show
			0 "lv" ui::save
			ui::wait drop drop
			return
		}
		ui::show
		ui::wait -> ch -> key
		key ch digit_of -> d
		key ch ui::keyname -> name
		name "ESC" == if {
			step 0 == if {
				now "t" ui::save
				return
			}
			step 1 - -> step
		}
		i -> was
		name "UP" == if { i 72 + 81 % -> i }
		name "DOWN" == if { i 9 + 81 % -> i }
		name "LEFT" == if { i 9 / 9 * i 8 + 9 % + -> i }
		name "RIGHT" == if { i 9 / 9 * i 1 + 9 % + -> i }
		// An arrow moves the cell, and the box goes with it
		i was != if {
			i 9 / 3 / 3 * i 9 % 3 / + -> box
			2 -> step
		}
		name "DEL" == d 0 == or step 2 == and if {
			f i nth 0 == if {
				g i 0 set
				g i 9 / pack "g" i 9 / ui::cat ui::save
				0 -> step
			}
		}
		d 1 >= if {
			step 0 == if {
				d place -> col -> row
				row 3 * col + -> box
				1 -> step
			} else {
				step 1 == if {
					d place -> col -> row
					box 3 / 3 * row + 9 * box 3 % 3 * col + + -> i
					2 -> step
				} else {
					f i nth 0 == if {
						g i d set
						g i 9 / pack "g" i 9 / ui::cat ui::save
						now "t" ui::save
						0 -> step
					}
				}
			}
		}
	}
}

fn main() {
	"marks" ui::load 0 == if { drop 1 } -> marks
	loop {
		"lv" ui::load drop -> saved
		[]str -> items
		saved 0 > if { items "CONTINUE" append drop }
		items "NEW EASY" append "NEW MEDIUM" append "NEW HARD" append drop
		marks 1 == if { items "MISTAKES SHOWN" append drop } else { items "MISTAKES HIDDEN" append drop }
		saved 0 > if { 1 } else { 0 } -> off
		"SUDOKU" items ui::menu off - -> k
		k off neg == if { return }
		k 0 == if { "g" unpack "f" unpack saved "t" ui::load drop marks play }
		k 1 >= k 3 <= and if {
			k deal -> g
			g fixed -> f
			0 9 1 for r {
				g r pack "g" r ui::cat ui::save
				f r pack "f" r ui::cat ui::save
			}
			k "lv" ui::save
			0 "t" ui::save
			g f k 0 marks play
		}
		k 4 == if {
			1 marks - -> marks
			marks "marks" ui::save
		}
	}
}
