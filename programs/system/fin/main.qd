// Loan payments: give three of amount, rate, years and monthly payment

fn cents(x:f64 -- y:f64) {
	x 100.0 * round 100.0 divide
}

fn pay(p:f64 rate:f64 years:f64 -- m:f64) {
	rate 1200.0 divide -> i
	years 12.0 * -> n
	i 0.0 == if { p n divide return }
	p i * 1.0 1.0 i + n neg pow - divide
}

// The payment a rate gives, less the one wanted, for root to find nought in
fn gap(rate:f64 -- y:f64) {
	0 ui::get rate 2 ui::get pay 3 ui::get -
}

fn ask(prompt:str -- x:f64 ok:i64) {
	prompt ui::ask
}

fn main() {
	"SOLVE FOR" ["PAYMENT" "LOAN" "RATE %" "YEARS"] ui::menu -> want
	want 0 == if { return }

	want 2 != if { "LOAN?" ask 0 == if { drop return } 0 ui::put }
	want 3 != if { "RATE %?" ask 0 == if { drop return } 1 ui::put }
	want 4 != if { "YEARS?" ask 0 == if { drop return } 2 ui::put }
	want 1 != if { "PAYMENT?" ask 0 == if { drop return } 3 ui::put }

	0 ui::get -> p
	1 ui::get 1200.0 divide -> i
	2 ui::get 12.0 * -> n
	3 ui::get -> m

	want 1 == if { p 1 ui::get 2 ui::get pay 3 ui::put }
	want 2 == if {
		i 0.0 == if { m n * } else { m 1.0 1.0 i + n neg pow - * i divide } 0 ui::put
	}
	want 3 == if {
		m n * p <= if { "PAYMENT TOO SMALL" ui::say return }
		"gap" 0.000001 200.0 root 1 ui::put
	}
	want 4 == if {
		p i * m >= if { "NEVER PAID OFF" ui::say return }
		i 0.0 == if { p m divide } else { 1.0 p i * m divide - ln neg 1.0 i + ln divide } 12.0 divide 2 ui::put
	}

	0 ui::get -> p
	3 ui::get -> m
	2 ui::get 12.0 * -> n
	"LOAN      " p cents ui::cat print nl
	"RATE %    " 1 ui::get 1000.0 * round 1000.0 divide ui::cat print nl
	"YEARS     " 2 ui::get 100.0 * round 100.0 divide ui::cat print nl
	"PAYMENT   " m cents ui::cat print nl
	"TOTAL     " m n * cents ui::cat print nl
	"INTEREST  " m n * p - cents ui::cat print nl
	ui::pause
}
