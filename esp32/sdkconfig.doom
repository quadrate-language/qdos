# DOOM, linked in. Needs 16 MB of flash (an N16R8), the WAD in ../qdos-doom/doom,
# and a fresh sdkconfig:
#   rm -f sdkconfig
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.doom" build
CONFIG_QDOS_DOOM=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-doom.csv"
# DOOM's initialised data is internal RAM the shell's stack also needs; QDOS
# uses under 30 KB of the 64 KB kept back for DMA and internal-only buffers
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
