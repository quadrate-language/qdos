# The ESP32-S3 with octal PSRAM, as on an N8R8 or N16R8 module
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM. The shell's state, the parsed programs and the value stack go there:
# anything over the threshold is placed in PSRAM first, and the smaller
# allocations spill into it once internal RAM is gone. 64 KB of internal RAM is
# kept back for DMA and for the drivers that insist on it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Static buffers too, where a component's linker fragment asks (the shell and
# Quadrate do): the shell's stack wants the internal RAM they would take
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Quadrate's compiler front-end catches std::filesystem errors and uses RTTI
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# The shell runs on core 1 and may compute for seconds at a time; the watchdog
# on that core's idle task would call that a hang
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# A stack overflow should stop the machine where it happens
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# The store: long names (settings.angle, doom/main.qd), and a few files open
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_VOLUME_COUNT=2

# The USB port is the console, and the keyboard until the keypad exists
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The keypad is scanned every 5 ms while a key is down
CONFIG_FREERTOS_HZ=1000
