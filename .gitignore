# Build outputs, and the extra Meson build directories beside build/
build/
build-*/
dist/
compile_commands.json

# Firmware image build. The default output is ~/.cache/qdos-firmware, but
# QDOS_BUILD_DIR can point it back inside the tree.
firmware/build/
firmware/buildroot-*/
*.img

# Simulated persistent storage, written by the SDL3 backend
qdos-store/

# IDE/Editor
.cache/
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# AI assistant context (local only)
CLAUDE.md

# Python bytecode from the font tools
__pycache__/

# ESP-IDF: every build directory (build, build-qemu, ...), and the sdkconfig
# idf.py writes beside the defaults
esp32/build/
esp32/build-*/
esp32/sdkconfig
esp32/sdkconfig.old

# KiCad: lock files, per-user view state, backups and caches
*.lck
*.kicad_prl
*-backups/
_autosave-*
fp-info-cache
